CUP_CONFIG=/app/configs/config.example.yaml
CUP_SERVER_ADDR=:8080
CUP_SERVER_PUBLIC_URL=https://{{ cup_public_host }}
CUP_SERVER_COOKIE_SECURE=true
CUP_DB_HOST={{ cup_db_host }}
CUP_DB_PORT=5432
CUP_DB_DBNAME={{ shared_db_name }}
CUP_DB_USER=cup_app
CUP_DB_PASSWORD={{ cup_db_password }}
CUP_DB_SSLMODE=disable
CUP_DB_SCHEMA=cup
CUP_S95_BASE_URL=https://s95.ru
CUP_S95_API_KEY={{ cup_s95_api_key }}
CUP_S95_SSO_SECRET={{ cup_sso_secret }}
CUP_S95_RATE_LIMIT_RPS=5
CUP_S95_MOCK=false
CUP_AUTH_JWT_SECRET={{ cup_jwt_secret }}
CUP_AUTH_JWT_TTL_HOURS=168
CUP_AUTH_DEV_AUTH_ENABLED=false
CUP_AUTH_ADMIN_ATHLETE_CODES={{ cup_admin_athlete_codes | default('') }}
CUP_REGISTRATION_DEADLINE_HOURS_BEFORE_STAGE=168
CUP_SYNC_LOCATIONS_INTERVAL_HOURS=24
CUP_SYNC_PROTOCOL_POLL_INTERVAL_MINUTES=15
