FROM golang:1.26.11-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /cup-api ./cmd/cup-api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /cup-api /app/cup-api
COPY configs/config.example.yaml /app/configs/config.example.yaml
COPY migrations /app/migrations
EXPOSE 8080
ENTRYPOINT ["/app/cup-api"]